{
  "manifest_version": 3,
  "name": "MV3 Probe (lifetime mode)",
  "version": "2.0",
  "description": "Run 2: no heartbeat — measures whether the worker dies unaided.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["probe-content.js"],
      "run_at": "document_idle"
    }
  ]
}
